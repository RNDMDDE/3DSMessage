  CompanyCode             : "00"
  ProductCode             : "CTR-P-MSGS"
  ContentType             : Application
  Logo                    : Homebrew

TitleInfo:
  UniqueId                : 0x0FF123
  Category                : Application

Option:
  UseOnSD                 : true
  EnableCompress          : true
  FreeProductCode         : true
  EnableCrypt             : false
  MediaFootPadding        : false

AccessControlInfo:
